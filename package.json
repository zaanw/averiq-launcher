{
  "name": "averiq-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Minecraft Java Edition launcher — Created by Averiq",
  "author": "Averiq",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.node.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js && cross-env AVERIQ_DEV=1 electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "source": "node scripts/source.mjs",
    "dist:unsigned": "npm run build && electron-builder --win nsis portable --x64 --config.win.signAndEditExecutable=false",
    "test:desktop": "npm run build && node scripts/electron-smoke.cjs",
    "test:integration": "npm run build && node scripts/integration.cjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@xmcl/core": "2.14.0",
    "@xmcl/installer": "6.0.1",
    "@xmcl/task": "4.1.1",
    "adm-zip": "0.6.1",
    "https-proxy-agent": "7.0.6",
    "lucide-react": "0.468.0",
    "motion": "12.23.24",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/adm-zip": "0.5.7",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.0.12",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "3.2.4",
    "wait-on": "9.0.3"
  },
  "build": {
    "appId": "dev.averiq.launcher",
    "productName": "Averiq Launcher",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "resources/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Averiq-Launcher-${version}-Setup-${arch}.${ext}",
      "script": "resources/installer.nsi",
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ]
    },
    "artifactName": "Averiq-Launcher-${version}-${arch}.${ext}",
    "portable": {
      "artifactName": "Averiq-Launcher-${version}-Portable-${arch}.${ext}"
    }
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
